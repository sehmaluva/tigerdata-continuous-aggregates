# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your own Tiger Cloud connection string.
#
#     cp .env.example .env
#     $EDITOR .env
#     chmod 600 .env
#
# .env is git-ignored and must NEVER be committed or shared. The values below
# are placeholders only - no real host or password lives in this repository.
#
# Where to find it: Tiger Cloud console -> your service -> "Connect" -> copy
# the PostgreSQL connection string (psql / URI tab). It looks like:
#
#     postgres://tsdbadmin:<PASSWORD>@<HOST>:<PORT>/<DBNAME>?sslmode=require
#
# TLS is required for hosted connections. run_sql.sh also forces
# PGSSLMODE=require, so the database is always reached over an encrypted link.
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://tsdbadmin:REPLACE_WITH_YOUR_PASSWORD@REPLACE_WITH_YOUR_HOST:5432/tsdb?sslmode=require
